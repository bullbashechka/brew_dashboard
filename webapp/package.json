{
  "name": "@brew-dashboard/webapp",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && XDG_CONFIG_HOME=../.scratch/wrangler-config WRANGLER_WRITE_LOGS=false vite build && node ../scripts/build-artifact-security.mjs sanitize",
    "dev": "XDG_CONFIG_HOME=../.scratch/wrangler-config WRANGLER_WRITE_LOGS=false vite",
    "lint": "eslint .",
    "test": "bun test --preload ./tests/setup.ts tests/unit",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@brew-dashboard/contracts": "workspace:*",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-popover": "^1.1.23",
    "@tanstack/react-form": "^1.0.0",
    "@tanstack/react-query": "^5.0.0",
    "@tanstack/react-router": "^1.0.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.0.0",
    "lucide-react": "^1.34.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^3.0.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@cloudflare/vite-plugin": "^1.0.0",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "happy-dom": "^20.11.6",
    "tailwindcss": "^4.0.0",
    "vite": "^8.0.0",
    "wrangler": "^4.0.0"
  }
}
