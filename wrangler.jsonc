{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "brew-dashboard",
  "main": "./backend/src/index.ts",
  "compatibility_date": "2026-08-21",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    "BETTER_AUTH_URL": "https://brew-dashboard.bullbashechka.workers.dev",
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": false,
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.1,
      "persist": true,
    },
  },
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "0fa9081629d645a8945914bdc517a194",
    },
  ],
}
